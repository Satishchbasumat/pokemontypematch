<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Pokémon Type Codex — The Logic Behind the Battle</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@300;400;600&family=Crimson+Pro:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet"/>
<style>
:root {
  --fire: #FF6B35;
  --water: #4FC3F7;
  --grass: #66BB6A;
  --electric: #FFD54F;
  --ice: #80DEEA;
  --fighting: #EF5350;
  --poison: #CE93D8;
  --ground: #BCAAA4;
  --flying: #90CAF9;
  --psychic: #F48FB1;
  --bug: #AED581;
  --rock: #A1887F;
  --ghost: #7986CB;
  --dragon: #7C4DFF;
  --dark: #546E7A;
  --steel: #B0BEC5;
  --fairy: #F8BBD9;
  --normal: #E0E0E0;
  --bg: #060912;
  --surface: rgba(255,255,255,0.04);
  --surface2: rgba(255,255,255,0.08);
  --border: rgba(255,255,255,0.1);
  --text: #E8EAF6;
  --muted: rgba(232,234,246,0.5);
}

*{margin:0;padding:0;box-sizing:border-box;}

html{scroll-behavior:smooth;}

body{
  font-family:'Rajdhani',sans-serif;
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
  cursor:none;
}

/* CUSTOM CURSOR */
.cursor{position:fixed;width:12px;height:12px;border-radius:50%;background:#FFD54F;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform 0.1s,width 0.2s,height 0.2s;mix-blend-mode:difference;}
.cursor-ring{position:fixed;width:36px;height:36px;border-radius:50%;border:1.5px solid rgba(255,213,79,0.5);pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:transform 0.15s ease,width 0.2s,height 0.2s;}

/* PARTICLES */
#particles{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:0;overflow:hidden;}
.particle{position:absolute;border-radius:50%;animation:float linear infinite;}
@keyframes float{0%{transform:translateY(100vh) rotate(0deg);opacity:0;}10%{opacity:1;}90%{opacity:1;}100%{transform:translateY(-10vh) rotate(720deg);opacity:0;}}

/* POKEBALL LOADER */
#loader{
  position:fixed;inset:0;z-index:10000;
  background:var(--bg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;
  transition:opacity 0.8s;
}
.pokeball{width:80px;height:80px;position:relative;animation:spin 1s linear infinite;}
.pokeball::before,.pokeball::after{content:'';position:absolute;inset:0;border-radius:50%;}
.pokeball::before{background:linear-gradient(180deg,#EF5350 50%,#fff 50%);border:4px solid #333;}
.pokeball::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:20px;height:20px;border-radius:50%;background:#fff;border:4px solid #333;box-shadow:0 0 0 4px #fff, 0 0 0 8px #333;}
@keyframes spin{to{transform:rotate(360deg);}}
.loader-text{font-family:'Orbitron',monospace;font-size:0.8rem;letter-spacing:0.3em;color:var(--muted);animation:pulse 1.2s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:0.4;}50%{opacity:1;}}

/* NAV */
nav{
  position:fixed;top:0;left:0;right:0;z-index:100;
  padding:1rem 2rem;
  display:flex;align-items:center;justify-content:space-between;
  background:rgba(6,9,18,0.7);
  backdrop-filter:blur(20px);
  border-bottom:1px solid var(--border);
}
.nav-logo{font-family:'Orbitron',monospace;font-size:1rem;font-weight:900;letter-spacing:0.1em;background:linear-gradient(135deg,#FFD54F,#FF6B35);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.nav-links{display:flex;gap:2rem;list-style:none;}
.nav-links a{color:var(--muted);text-decoration:none;font-size:0.85rem;letter-spacing:0.1em;text-transform:uppercase;transition:color 0.2s;}
.nav-links a:hover{color:var(--text);}
.music-btn{
  background:var(--surface);border:1px solid var(--border);
  color:var(--text);padding:0.4rem 1rem;border-radius:2rem;
  font-family:'Rajdhani',sans-serif;font-size:0.8rem;letter-spacing:0.1em;
  cursor:pointer;transition:all 0.2s;display:flex;align-items:center;gap:0.5rem;
}
.music-btn:hover{background:var(--surface2);border-color:rgba(255,213,79,0.4);}

/* HERO */
#hero{
  min-height:100vh;position:relative;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  text-align:center;padding:6rem 2rem 4rem;overflow:hidden;
}
.hero-bg{
  position:absolute;inset:0;
  background:radial-gradient(ellipse 80% 60% at 50% 40%, rgba(124,77,255,0.15) 0%, transparent 70%),
             radial-gradient(ellipse 40% 40% at 80% 60%, rgba(255,107,53,0.1) 0%, transparent 60%),
             radial-gradient(ellipse 40% 40% at 20% 70%, rgba(79,195,247,0.1) 0%, transparent 60%);
}
.hero-orbs{position:absolute;inset:0;overflow:hidden;}
.orb{position:absolute;border-radius:50%;filter:blur(60px);animation:orb-drift ease-in-out infinite alternate;}
@keyframes orb-drift{0%{transform:translate(0,0);}100%{transform:translate(30px,-20px);}}

.hero-badge{
  display:inline-flex;align-items:center;gap:0.5rem;
  background:var(--surface);border:1px solid rgba(255,213,79,0.3);
  padding:0.4rem 1.2rem;border-radius:2rem;
  font-size:0.75rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--electric);
  margin-bottom:2rem;animation:fadeUp 0.6s 0.3s both;
}
.hero-title{
  font-family:'Orbitron',monospace;
  font-size:clamp(2rem,6vw,4.5rem);
  font-weight:900;line-height:1.1;
  background:linear-gradient(135deg,#fff 0%,#E8EAF6 40%,#FFD54F 70%,#FF6B35 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  margin-bottom:1.5rem;
  animation:fadeUp 0.6s 0.5s both;
}
.hero-sub{
  font-family:'Crimson Pro',serif;
  font-size:clamp(1rem,2.5vw,1.4rem);
  color:var(--muted);max-width:650px;line-height:1.7;
  margin-bottom:3rem;animation:fadeUp 0.6s 0.7s both;
}
.cta-btn{
  display:inline-flex;align-items:center;gap:0.75rem;
  background:linear-gradient(135deg,#7C4DFF,#FF6B35);
  color:#fff;padding:1rem 2.5rem;border-radius:3rem;
  font-family:'Orbitron',monospace;font-size:0.85rem;letter-spacing:0.1em;
  text-decoration:none;border:none;cursor:pointer;
  box-shadow:0 0 40px rgba(124,77,255,0.4);
  transition:all 0.3s;animation:fadeUp 0.6s 0.9s both;
  position:relative;overflow:hidden;
}
.cta-btn::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,0.2),transparent);opacity:0;transition:opacity 0.3s;}
.cta-btn:hover{transform:translateY(-2px);box-shadow:0 0 60px rgba(124,77,255,0.6);}
.cta-btn:hover::before{opacity:1;}

@keyframes fadeUp{from{opacity:0;transform:translateY(20px);}to{opacity:1;transform:translateY(0);}}

.scroll-hint{position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:0.5rem;color:var(--muted);font-size:0.7rem;letter-spacing:0.2em;animation:bob 2s ease-in-out infinite;}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0);}50%{transform:translateX(-50%) translateY(6px);}}
.scroll-arrow{width:20px;height:20px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg);}

/* SECTIONS */
section{position:relative;z-index:1;padding:5rem 2rem;}
.section-label{font-size:0.7rem;letter-spacing:0.3em;text-transform:uppercase;color:var(--electric);margin-bottom:0.75rem;}
.section-title{font-family:'Orbitron',monospace;font-size:clamp(1.5rem,4vw,2.5rem);font-weight:700;margin-bottom:1rem;line-height:1.2;}
.section-desc{color:var(--muted);font-family:'Crimson Pro',serif;font-size:1.1rem;max-width:600px;line-height:1.7;margin-bottom:3rem;}

/* TYPE GRID */
.type-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(140px,1fr));
  gap:1rem;max-width:1100px;margin:0 auto;
}
.type-card{
  background:var(--surface);
  border:1px solid var(--border);
  border-radius:1rem;
  padding:1.5rem 1rem;
  text-align:center;
  cursor:pointer;
  transition:all 0.3s;
  position:relative;overflow:hidden;
}
.type-card::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 50% 0%, var(--type-color,#fff) 0%, transparent 70%);
  opacity:0;transition:opacity 0.3s;
}
.type-card:hover::before{opacity:0.12;}
.type-card:hover{transform:translateY(-4px);border-color:var(--type-color,#fff);box-shadow:0 8px 30px rgba(0,0,0,0.3),0 0 20px rgba(var(--type-rgb,255,255,255),0.2);}
.type-card.active{border-color:var(--type-color,#fff);box-shadow:0 0 30px rgba(0,0,0,0.5),inset 0 0 20px rgba(var(--type-rgb,255,255,255),0.05);}
.type-emoji{font-size:2rem;margin-bottom:0.5rem;display:block;}
.type-name{font-family:'Orbitron',monospace;font-size:0.7rem;letter-spacing:0.1em;font-weight:700;color:var(--type-color,#fff);}

/* TYPE DETAIL PANEL */
#type-detail{
  max-width:900px;margin:2rem auto 0;
  background:var(--surface);border:1px solid var(--border);
  border-radius:1.5rem;padding:2.5rem;
  display:none;animation:fadeUp 0.4s both;
  position:relative;overflow:hidden;
}
#type-detail::before{
  content:'';position:absolute;top:-50%;right:-20%;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,var(--active-color,#fff) 0%,transparent 70%);
  opacity:0.05;pointer-events:none;
}
.detail-header{display:flex;align-items:center;gap:1.5rem;margin-bottom:2rem;flex-wrap:wrap;}
.detail-icon{font-size:3.5rem;}
.detail-info h2{font-family:'Orbitron',monospace;font-size:1.8rem;font-weight:900;color:var(--active-color,#fff);}
.detail-info p{color:var(--muted);font-family:'Crimson Pro',serif;font-size:1rem;font-style:italic;}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-bottom:2rem;}
.detail-box{background:var(--surface2);border-radius:1rem;padding:1.5rem;}
.detail-box h3{font-family:'Orbitron',monospace;font-size:0.75rem;letter-spacing:0.15em;margin-bottom:1rem;opacity:0.6;}
.lore-text{font-family:'Crimson Pro',serif;font-size:1rem;line-height:1.8;color:var(--text);}
.matchup-chips{display:flex;flex-wrap:wrap;gap:0.5rem;}
.chip{padding:0.25rem 0.75rem;border-radius:2rem;font-size:0.75rem;font-family:'Orbitron',monospace;letter-spacing:0.05em;border:1px solid rgba(255,255,255,0.15);}
.chip.strong{background:rgba(102,187,106,0.15);color:#66BB6A;border-color:rgba(102,187,106,0.3);}
.chip.weak{background:rgba(239,83,80,0.15);color:#EF5350;border-color:rgba(239,83,80,0.3);}
.chip.immune{background:rgba(120,120,120,0.15);color:#999;border-color:rgba(120,120,120,0.3);}

/* BATTLE SIMULATOR */
#simulator{background:rgba(0,0,0,0.3);}
.sim-container{max-width:800px;margin:0 auto;}
.sim-selectors{display:grid;grid-template-columns:1fr auto 1fr;gap:1rem;align-items:center;margin-bottom:2rem;}
.sim-select{
  background:var(--surface);border:1px solid var(--border);
  color:var(--text);padding:1rem 1.5rem;border-radius:1rem;
  font-family:'Orbitron',monospace;font-size:0.8rem;letter-spacing:0.05em;
  width:100%;appearance:none;cursor:pointer;
  transition:all 0.2s;
}
.sim-select:focus{outline:none;border-color:var(--electric);box-shadow:0 0 0 3px rgba(255,213,79,0.1);}
.sim-vs{font-family:'Orbitron',monospace;font-size:1.5rem;font-weight:900;text-align:center;background:linear-gradient(135deg,#FFD54F,#FF6B35);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.sim-result{
  background:var(--surface);border:1px solid var(--border);
  border-radius:1.5rem;padding:2.5rem;text-align:center;
  min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:1rem;position:relative;overflow:hidden;
}
.effectiveness-display{
  font-family:'Orbitron',monospace;font-size:4rem;font-weight:900;
  line-height:1;transition:all 0.4s;
}
.effectiveness-label{font-size:0.8rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--muted);}
.sim-explanation{
  font-family:'Crimson Pro',serif;font-size:1.1rem;line-height:1.7;
  color:var(--muted);max-width:500px;
}

/* TYPE CHART */
#chart-section{overflow-x:auto;}
.chart-wrap{overflow-x:auto;max-width:100%;}
.type-matrix{border-collapse:separate;border-spacing:2px;font-size:0.6rem;min-width:800px;}
.type-matrix th{
  font-family:'Orbitron',monospace;font-size:0.55rem;letter-spacing:0.05em;
  padding:0.4rem;text-align:center;color:var(--muted);
  position:sticky;
}
.type-matrix td{
  width:30px;height:30px;text-align:center;border-radius:4px;
  cursor:pointer;transition:all 0.15s;font-weight:700;font-size:0.7rem;
  position:relative;
}
.type-matrix td:hover{transform:scale(1.3);z-index:10;}
.eff-2{background:rgba(102,187,106,0.5);color:#A5D6A7;}
.eff-0_5{background:rgba(239,83,80,0.3);color:#EF9A9A;}
.eff-0{background:rgba(100,100,100,0.3);color:#777;}
.eff-1{background:rgba(255,255,255,0.04);color:rgba(255,255,255,0.15);}

/* MYTH SECTION */
.myth-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:1.5rem;max-width:1100px;margin:0 auto;}
.myth-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:1.5rem;padding:2rem;
  transition:all 0.3s;position:relative;overflow:hidden;
}
.myth-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--c1),var(--c2));}
.myth-card:hover{transform:translateY(-4px);border-color:rgba(255,255,255,0.2);}
.myth-icon{font-size:2.5rem;margin-bottom:1rem;}
.myth-card h3{font-family:'Orbitron',monospace;font-size:0.9rem;font-weight:700;margin-bottom:0.75rem;letter-spacing:0.05em;}
.myth-card p{font-family:'Crimson Pro',serif;font-size:0.95rem;line-height:1.7;color:var(--muted);}

/* FUN FACTS */
.facts-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;max-width:1100px;margin:0 auto;}
.fact-card{
  background:var(--surface);border:1px solid var(--border);
  border-radius:1rem;padding:1.5rem;
  display:flex;gap:1rem;align-items:flex-start;
  transition:all 0.2s;
}
.fact-card:hover{background:var(--surface2);}
.fact-num{font-family:'Orbitron',monospace;font-size:1.5rem;font-weight:900;opacity:0.2;min-width:2rem;}
.fact-text{font-family:'Crimson Pro',serif;font-size:0.95rem;line-height:1.6;color:var(--muted);}

/* FOOTER */
footer{
  text-align:center;padding:3rem 2rem;
  border-top:1px solid var(--border);
  color:var(--muted);font-size:0.8rem;letter-spacing:0.1em;
}

/* SEARCH */
.search-wrap{max-width:400px;margin:0 auto 3rem;position:relative;}
.search-input{
  width:100%;background:var(--surface);border:1px solid var(--border);
  color:var(--text);padding:0.9rem 1.5rem 0.9rem 3rem;border-radius:3rem;
  font-family:'Rajdhani',sans-serif;font-size:1rem;
  transition:all 0.2s;
}
.search-input:focus{outline:none;border-color:var(--electric);box-shadow:0 0 0 3px rgba(255,213,79,0.1);}
.search-icon{position:absolute;left:1rem;top:50%;transform:translateY(-50%);opacity:0.5;font-size:1.1rem;}

/* GENERATION TIMELINE */
.timeline{max-width:900px;margin:0 auto;position:relative;}
.timeline::before{content:'';position:absolute;left:2rem;top:0;bottom:0;width:1px;background:var(--border);}
.tl-item{display:flex;gap:2rem;margin-bottom:3rem;position:relative;}
.tl-dot{
  width:1rem;height:1rem;border-radius:50%;
  background:var(--electric);min-width:1rem;
  margin-top:0.3rem;box-shadow:0 0 10px var(--electric);
  margin-left:-0.5rem;
}
.tl-content{flex:1;}
.tl-gen{font-family:'Orbitron',monospace;font-size:0.7rem;letter-spacing:0.15em;color:var(--electric);margin-bottom:0.3rem;}
.tl-title{font-family:'Orbitron',monospace;font-size:1rem;font-weight:700;margin-bottom:0.5rem;}
.tl-desc{font-family:'Crimson Pro',serif;font-size:0.95rem;line-height:1.6;color:var(--muted);}
.tl-types{display:flex;gap:0.5rem;flex-wrap:wrap;margin-top:0.75rem;}
.tl-badge{padding:0.2rem 0.7rem;border-radius:2rem;font-size:0.65rem;font-family:'Orbitron',monospace;border:1px solid rgba(255,255,255,0.2);}

/* RANDOM GEN */
.random-btn{
  display:flex;align-items:center;gap:0.75rem;
  background:var(--surface);border:1px solid var(--border);
  color:var(--text);padding:0.75rem 2rem;border-radius:3rem;
  font-family:'Orbitron',monospace;font-size:0.8rem;letter-spacing:0.1em;
  cursor:pointer;margin:0 auto 2rem;transition:all 0.2s;
}
.random-btn:hover{background:var(--surface2);border-color:rgba(255,213,79,0.4);}

/* RESPONSIVE */
@media(max-width:768px){
  .detail-grid{grid-template-columns:1fr;}
  .sim-selectors{grid-template-columns:1fr;gap:0.5rem;}
  .sim-vs{font-size:1rem;}
  nav .nav-links{display:none;}
  .timeline::before{left:0;}
  .tl-dot{margin-left:-0.5rem;}
  .tl-item{gap:1rem;}
}

/* SCROLL REVEAL */
.reveal{opacity:0;transform:translateY(30px);transition:opacity 0.6s,transform 0.6s;}
.reveal.visible{opacity:1;transform:translateY(0);}

/* TOOLTIP */
.tooltip{
  position:fixed;z-index:200;
  background:rgba(6,9,18,0.95);border:1px solid var(--border);
  border-radius:0.75rem;padding:1rem 1.25rem;max-width:280px;
  pointer-events:none;display:none;backdrop-filter:blur(10px);
}
.tooltip h4{font-family:'Orbitron',monospace;font-size:0.75rem;margin-bottom:0.5rem;color:var(--electric);}
.tooltip p{font-family:'Crimson Pro',serif;font-size:0.9rem;line-height:1.5;color:var(--muted);}

/* GLOW PULSE */
@keyframes glow-pulse{0%,100%{box-shadow:0 0 20px rgba(255,213,79,0.2);}50%{box-shadow:0 0 40px rgba(255,213,79,0.4);}}
</style>
</head>
<body>

<!-- CURSOR -->
<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- PARTICLES -->
<div id="particles"></div>

<!-- LOADER -->
<div id="loader">
  <div class="pokeball"></div>
  <div class="loader-text">LOADING TYPE CODEX...</div>
</div>

<!-- TOOLTIP -->
<div class="tooltip" id="tooltip">
  <h4 id="tt-title"></h4>
  <p id="tt-body"></p>
</div>

<!-- NAV -->
<nav>
  <div class="nav-logo">⚡ TYPE CODEX</div>
  <ul class="nav-links">
    <li><a href="#types">Types</a></li>
    <li><a href="#simulator">Simulator</a></li>
    <li><a href="#chart-section">Chart</a></li>
    <li><a href="#mythology">Lore</a></li>
    <li><a href="#timeline">History</a></li>
  </ul>
  <button class="music-btn" id="musicToggle">♪ AMBIENCE OFF</button>
</nav>

<!-- HERO -->
<section id="hero">
  <div class="hero-bg"></div>
  <div class="hero-orbs">
    <div class="orb" style="width:400px;height:400px;background:rgba(124,77,255,0.15);top:-100px;left:-100px;animation-duration:8s;"></div>
    <div class="orb" style="width:300px;height:300px;background:rgba(255,107,53,0.1);bottom:-50px;right:-50px;animation-duration:10s;"></div>
    <div class="orb" style="width:200px;height:200px;background:rgba(79,195,247,0.1);top:40%;right:10%;animation-duration:7s;"></div>
  </div>
  <span class="hero-badge">✦ POKÉMON TYPE LORE MUSEUM ✦</span>
  <h1 class="hero-title">The Logic Behind<br>Pokémon Type Matchups</h1>
  <p class="hero-sub">Discover the science, mythology, nature, and ancient legends that define every Pokémon battle. This is not just a chart — it's a civilisation of elemental knowledge.</p>
  <a href="#types" class="cta-btn">⚔ Explore the Type World</a>
  <div class="scroll-hint">SCROLL<div class="scroll-arrow"></div></div>
</section>

<!-- TYPES EXPLORER -->
<section id="types">
  <div style="text-align:center;max-width:1100px;margin:0 auto;">
    <p class="section-label">The Eighteen Elements</p>
    <h2 class="section-title reveal">Choose Your Type</h2>
    <p class="section-desc reveal" style="margin:0 auto 2rem;">Each type carries a universe of meaning — click to unveil its origin, lore, and battle logic.</p>
    <div class="search-wrap reveal">
      <span class="search-icon">🔍</span>
      <input type="text" class="search-input" id="typeSearch" placeholder="Search a type...">
    </div>
    <div class="type-grid" id="typeGrid"></div>
    <div id="type-detail"></div>
  </div>
</section>

<!-- BATTLE SIMULATOR -->
