const typeGrid = document.getElementById('typeGrid');
let activeType = null;

function renderTypeGrid(filter=''){
  typeGrid.innerHTML='';
  TYPES.filter(t=>t.name.toLowerCase().includes(filter.toLowerCase())).forEach(t=>{
    const card = document.createElement('div');
    card.className = 'type-card' + (activeType===t.name?' active':'');
    card.style.setProperty('--type-color',t.color);
    card.innerHTML = `<span class="type-emoji">${t.emoji}</span><div class="type-name">${t.name}</div>`;
    card.addEventListener('click',()=>{
      activeType = activeType===t.name?null:t.name;
      renderTypeGrid(filter);
      renderTypeDetail(activeType?t:null);
      if(activeType) document.getElementById('type-detail').scrollIntoView({behavior:'smooth',block:'nearest'});
    });
    typeGrid.appendChild(card);
  });
}

function renderTypeDetail(t){
  const panel = document.getElementById('type-detail');
  if(!t){panel.style.display='none';return;}
  panel.style.display='block';
  panel.style.setProperty('--active-color',t.color);
  const pokemonStr = t.pokemon.map(p=>`<span class="chip" style="border-color:${t.color}33;color:${t.color};">${p}</span>`).join('');
  const strongStr = t.strong.map(s=>`<span class="chip strong">${s}</span>`).join('')||'<span style="color:var(--muted)">None</span>';
