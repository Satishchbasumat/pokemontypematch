// BATTLE SIMULATOR
// ═══════════════════════════════════════════════════════════
const attackerSel = document.getElementById('attacker');
const defenderSel = document.getElementById('defender');
TYPES.forEach(t=>{
  [attackerSel,defenderSel].forEach(sel=>{
    const opt = document.createElement('option');
    opt.value = t.name; opt.textContent = `${t.emoji} ${t.name}`;
    sel.appendChild(opt);
  });
});

function getEffLabel(val){
  if(val===2) return {text:'2×',color:'#66BB6A',label:'Super Effective!'};
  if(val===0.5) return {text:'½×',color:'#EF5350',label:'Not Very Effective...'};
  if(val===0) return {text:'0×',color:'#777',label:'No Effect!'};
  return {text:'1×',color:'var(--muted)',label:'Normal Effectiveness'};
}

function runSim(){
  const atk = attackerSel.value;
  const def = defenderSel.value;
  if(!atk||!def) return;
  const eff = rawChart[atk]?.[def]??1;
  const {text,color,label} = getEffLabel(eff);
  const loreKey = `${atk}-${def}`;
  const lore = BATTLE_LORE[loreKey]||`${atk} attacks ${def} with ${eff===1?'normal':eff>1?'tremendous':'reduced'} effect — the elemental balance plays out as the type chart dictates.`;
  const atkT = TYPES.find(t=>t.name===atk);
  const defT = TYPES.find(t=>t.name===def);
  document.getElementById('simResult').innerHTML = `
    <div style="position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,${color}22,transparent 70%);pointer-events:none;"></div>
    <div class="effectiveness-label">${atkT?.emoji||''} ${atk} → ${defT?.emoji||''} ${def}</div>
    <div class="effectiveness-display" style="color:${color};">${text}</div>
    <div class="effectiveness-label" style="color:${color};font-size:1rem;">${label}</div>
    <p class="sim-explanation">${lore}</p>
  `;
}

attackerSel.addEventListener('change',runSim);
defenderSel.addEventListener('change',runSim);

document.getElementById('randomBtn').addEventListener('click',()=>{
  const r = ()=>TYPES[Math.floor(Math.random()*TYPES.length)].name;
  attackerSel.value = r();
  defenderSel.value = r();
  runSim();
});

